	column 'Day of Week Short' = LEFT(dim_date[Day of Week], 3)
		lineageTag: d4e1b96b-4ccb-4f0f-8e8c-c00afa28f5b1
		summarizeBy: none
		sortByColumn: 'Day of Week Num'

		annotation SummarizationSetBy = Automatic

	partition dim_date = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR (DATE(2019, 10, 1), DATE(2019, 10, 31)),
				    "Day of Month", DAY([Date]),
				    "Day of Week Num", WEEKDAY([Date], 2), 
				    "Day of Week", FORMAT([Date], "dddd", "en-US"),
				    "Is Weekend", IF(WEEKDAY([Date], 2) >= 6, "Weekend", "Weekday")
				)
				```

	annotation PBI_Id = 32f0f98340c842a99affc3c0164c71af

